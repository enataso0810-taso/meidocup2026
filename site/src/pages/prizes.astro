---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import PrizeCard from '../components/PrizeCard.astro';
import SnsLinks from '../components/SnsLinks.astro';
import { PRIZE_CREATORS } from '../data/creators';
import { withBase } from '../lib/path';
import {
  RANK_PRIZES, RANK_PRIZES_NOTE, TROPHIES,
  HOST_PRIZES, PERSONAL_PRIZES, INVITED_PRIZES, EXHIBITION_PRIZES,
} from '../data/prizes';


const totalCount =
  RANK_PRIZES.length + HOST_PRIZES.length + PERSONAL_PRIZES.length +
  INVITED_PRIZES.length + EXHIBITION_PRIZES.length;

const jumps = [
  { id: 'rank', label: '上位賞' },
  { id: 'trophy', label: 'トロフィー' },
  { id: 'host', label: '主催賞' },
  { id: 'personal', label: '個人協賛賞' },
  { id: 'invited', label: '招待枠限定' },
  { id: 'exhibition', label: 'エキシビジョン' },
];
---

<Base
  title="賞品"
  pageTitle="賞品"
  pageTitleEn="PRIZES"
  pageLead={`企業協賛による上位賞から、主催賞・個人協賛賞まで全${totalCount}賞。卓上のドラマひとつひとつに賞品が用意されています。`}
>
  {/* ===== 目次 ===== */}
  <section class="section">
    <div class="shell">
      <nav class="jump reveal" aria-label="賞品カテゴリ">
        {jumps.map((j) => <a href={`#${j.id}`}>{j.label}</a>)}
      </nav>
    </div>
  </section>

  {/* ===== 上位賞 ===== */}
  <section class="section" id="rank">
    <div class="shell">
      <SectionHead
        title="上位賞"
        en="TOP PRIZES"
        lead="企業協賛による1位〜10位の賞品です。画像をクリックすると拡大表示できます。"
      />
      <div class="grid">
        {RANK_PRIZES.map((p) => <PrizeCard prize={p} tone="gold" />)}
      </div>
      <p class="note grid__note reveal">{RANK_PRIZES_NOTE}</p>
    </div>
  </section>

  {/* ===== トロフィーアクキー ===== */}
  <section class="section" id="trophy">
    <div class="shell">
      <SectionHead
        title="トロフィーアクリルキーホルダー"
        en="TROPHY ACRYLIC KEYCHAIN"
        lead="1〜3位の方には、賞品とあわせて明戸杯2026オリジナルのトロフィーデザインアクリルキーホルダーを贈呈します。"
      />

      <div class="trophies">
        {TROPHIES.map((t) => (
          <figure class:list={['trophy', `trophy--${t.label}`, 'reveal']}>
            <div class="trophy__glow" aria-hidden="true"></div>
            <img
              src={withBase(`assets/prizes/${t.image}`)}
              alt={`明戸杯2026 トロフィーアクキー ${t.label}（${t.rank}）`}
              width="620"
              height="866"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="trophy__rank">{t.rank}</span>
              <span class="trophy__label">{t.label}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 主催賞 ===== */}
  <section class="section" id="host">
    <div class="shell">
      <SectionHead
        title="主催賞"
        en="HOST AWARDS"
        lead="主催・明戸えな、主催サポート・おしたらあたるからの特別賞です。"
      />
      <div class="grid grid--wide">
        {HOST_PRIZES.map((p) => <PrizeCard prize={p} tone="crimson" />)}
      </div>

      {/* --- 主催賞の賞品を制作されたクリエイター --- */}
      <div class="makers">
        <p class="makers__head ribbon">賞品制作クリエイター</p>

        <div class="makers__list">
          {PRIZE_CREATORS.map((c) => (
            <article class="maker washi corner-key reveal">
              <div class="maker__top">
                {c.image ? (
                  <img
                    class="maker__img"
                    src={withBase(`assets/creators/${c.image}`)}
                    alt={c.name}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="maker__img maker__img--tbd" aria-hidden="true">{[...c.name][0]}</span>
                )}
                <div>
                  <p class="maker__role">{c.role}</p>
                  <h3 class="maker__name">{c.name}</h3>
                </div>
              </div>

              <p class="maker__bio">{c.bio}</p>
              <SnsLinks x={c.x} site={c.link} siteLabel={c.linkLabel} name={c.name} onPaper />
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ===== 個人協賛賞 ===== */}
  <section class="section" id="personal">
    <div class="shell">
      <SectionHead
        title="個人協賛賞"
        en="PERSONAL AWARDS"
        lead="個人協賛者の皆さまからご提供いただいた賞品です。"
      />
      <div class="grid">
        {PERSONAL_PRIZES.map((p) => <PrizeCard prize={p} tone="teal" />)}
      </div>
    </div>
  </section>

  {/* ===== 招待枠限定 ===== */}
  <section class="section" id="invited">
    <div class="shell">
      <SectionHead title="招待枠の方限定" en="INVITED ONLY" />
      <div class="grid grid--wide">
        {INVITED_PRIZES.map((p) => <PrizeCard prize={p} tone="teal" />)}
      </div>
    </div>
  </section>

  {/* ===== エキシビジョン ===== */}
  <section class="section" id="exhibition">
    <div class="shell">
      <SectionHead
        title="エキシビジョンマッチ企画の賞"
        en="EXHIBITION AWARDS"
        lead="秋のエキシビジョンマッチにまつわる3つの賞。ダービー賞は視聴者の皆さまも対象です。"
      />
      <div class="grid">
        {EXHIBITION_PRIZES.map((p) => <PrizeCard prize={p} tone="crimson" />)}
      </div>

      <div class="cross reveal">
        <p>投票方法・出演メンバーの詳細はエキシビジョンマッチのページへ。</p>
        <a class="btn btn-teal" href={withBase('exhibition/')}>エキシビジョンマッチを見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1rem 1.2rem;
    background: rgba(45, 2, 12, 0.42);
    border: 1px solid rgba(217, 164, 65, 0.32);
    border-radius: 4px;
  }
  .jump a {
    padding: 0.35rem 1.05rem;
    font-size: 0.88rem;
    letter-spacing: 0.06em;
    border: 1px solid rgba(217, 164, 65, 0.45);
    border-radius: 999px;
    color: var(--c-gold-light);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .jump a:hover { background: var(--c-crimson); border-color: var(--c-rouge-light); color: #fff; }

  /* --- トロフィー --- */
  .trophies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }
  .trophy {
    position: relative;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 2rem 1.2rem 1.5rem;
    background: linear-gradient(170deg, rgba(163, 10, 46, 0.4), rgba(45, 2, 12, 0.75));
    border: 1px solid rgba(217, 164, 65, 0.45);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), border-color 0.3s ease;
  }
  .trophy:hover { transform: translateY(-6px); border-color: var(--c-gold); }
  .trophy__glow {
    position: absolute;
    inset: -30% -10% auto;
    height: 90%;
    background: radial-gradient(60% 60% at 50% 50%, rgba(242, 216, 155, 0.3), transparent 70%);
    pointer-events: none;
  }
  .trophy--銀 .trophy__glow { background: radial-gradient(60% 60% at 50% 50%, rgba(226, 232, 240, 0.28), transparent 70%); }
  .trophy--銅 .trophy__glow { background: radial-gradient(60% 60% at 50% 50%, rgba(214, 150, 96, 0.28), transparent 70%); }
  .trophy img {
    position: relative;
    height: clamp(190px, 26vw, 270px);
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(20, 0, 8, 0.6));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .trophy:hover img { transform: scale(1.05) translateY(-4px); }
  .trophy figcaption {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .trophy__rank {
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.2rem, 3.4vw, 1.5rem);
    color: #fff;
  }
  .trophy__label {
    padding: 0.1rem 0.8rem;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    border-radius: 999px;
    border: 1px solid var(--c-gold);
    color: var(--c-gold-light);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }
  .grid--wide { grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
  .grid__note { margin-top: 1.4rem; }

  /* --- 賞品制作クリエイター --- */
  .makers { margin-top: clamp(2rem, 5vw, 3rem); }
  .makers__head { margin: 0 0 1.2rem; }
  .makers__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }
  .maker {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.3rem, 3.4vw, 1.8rem);
  }
  .maker__top { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.1rem; align-items: center; }
  .maker__img {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--c-gold);
    box-shadow: 0 4px 14px rgba(60, 4, 18, 0.28);
  }
  .maker__img--tbd {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--c-crimson), var(--c-crimson-dark));
    color: var(--c-gold-light);
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: 2rem;
  }
  .maker__role {
    margin: 0 0 0.3rem;
    display: inline-block;
    padding: 0.1rem 0.7rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    border-radius: 2px;
    background: rgba(200, 16, 60, 0.1);
    border: 1px solid rgba(200, 16, 60, 0.28);
    color: var(--c-crimson-deep);
  }
  .maker__name {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.15rem, 3vw, 1.4rem);
    color: var(--c-crimson-deep);
    line-height: 1.3;
  }
  .maker__bio { margin: 0; font-size: 0.92rem; line-height: 1.95; color: var(--c-ink); }

  .cross {
    margin-top: 2.4rem;
    padding: 1.6rem 1.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    background: linear-gradient(160deg, #10786a, #0a4b43);
    border: 1px solid rgba(42, 165, 149, 0.75);
    border-radius: 4px;
  }
  .cross p { margin: 0; font-family: var(--font-mincho); font-size: 1rem; color: #d5f6ef; }
</style>
