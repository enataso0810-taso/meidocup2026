---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import PersonCard from '../components/PersonCard.astro';
import PrizeCard from '../components/PrizeCard.astro';
import Countdown from '../components/Countdown.astro';
import { EXHIBITION_PLAYERS } from '../data/guests';
import { EXHIBITION_PRIZES } from '../data/prizes';
import { SITE, EXHIBITION_VOTE } from '../data/site';
import SnsLinks from '../components/SnsLinks.astro';
import { withBase } from '../lib/path';

const hasForm = EXHIBITION_VOTE.formUrl !== '';
const hasDeadline = EXHIBITION_VOTE.deadlineAt !== '';

const steps = [
  {
    n: '01',
    t: '出演メンバーから1位を予想',
    b: '下の4名から、エキシビジョンマッチで1位になると思う選手を選びます。',
  },
  {
    n: '02',
    t: '応募フォームから投票',
    b: 'Googleフォームに必要事項と予想する選手を入力して送信してください。投票は1人1回までです。',
  },
  {
    n: '03',
    t: `${SITE.hashtag} を付けてポスト`,
    b: '誰に投票したかをXでポストしていただけると、大会がより盛り上がります（任意）。',
  },
  {
    n: '04',
    t: '的中者から抽選で1名',
    b: '見事的中した方の中から抽選で1名様に「山本の米 新米10kg」をプレゼント。',
  },
];
---

<Base
  title="秋のエキシビジョンマッチ"
  pageTitle="秋のエキシビジョンマッチ"
  pageTitleEn="EXHIBITION MATCH"
  pageLead={"明戸杯2026トーナメント終了後にエキシビションマッチを企画！\n以下4名の鉄強雀士から、1位になる選手を予想して投票しよう！"}
>
  {/* ===== 投票案内 ===== */}
  <section class="section">
    <div class="shell">
      <div class="votebar panel reveal">
        <div class="votebar__lead">
          <p class="ribbon">投票受付中</p>
          <h2 class="votebar__title">1位を予想して<br /><span>山本の米 新米10kg</span>を当てよう</h2>

          <p class="votebar__body">
            見事的中した人の中から抽選で1名様に「山本の米 新米10kg」をプレゼント。<br />
            誰に投票したか、<a href={SITE.hashtagUrl} target="_blank" rel="noopener noreferrer">{SITE.hashtag}</a> のタグを付けてポストしてね！
          </p>

          <p class="votebar__open">
            <span class="votebar__open-tag">どなたでも参加OK</span>
            {EXHIBITION_VOTE.openTo}
          </p>

          <div class="votebar__cta">
            {hasForm ? (
              <a class="btn btn-teal" href={EXHIBITION_VOTE.formUrl} target="_blank" rel="noopener noreferrer">
                応募フォームから投票する
              </a>
            ) : (
              <span class="votebar__pending">応募フォーム準備中</span>
            )}
            <span class="votebar__deadline">受付：{EXHIBITION_VOTE.note}</span>
          </div>
        </div>

        <div class="votebar__side">
          <figure class="votebar__prizefig">
            <img
              class="votebar__prize"
              src={withBase('assets/prizes/yamamoto-rice.webp')}
              alt="山本の米 新米10kg"
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
            <figcaption>※写真はイメージです</figcaption>
          </figure>
          {hasDeadline && (
            <Countdown
              target={EXHIBITION_VOTE.deadlineAt}
              label="投票締め切りまで"
              finishedText="投票を締め切りました"
              variant="teal"
            />
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ===== 山本様 紹介 ===== */}
  <section class="section">
    <div class="shell">
      <div class="yamamoto washi corner-key reveal">
        <div class="yamamoto__figure">
          <img
            src={withBase('assets/exhibition/yamamoto-san.webp')}
            alt="山本様"
            width="620"
            height="690"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="yamamoto__body">
          <p class="ribbon ribbon-gold">賞品提供</p>
          <h2 class="yamamoto__name">山本様</h2>
          <p class="yamamoto__lead">
            ダービー賞の「山本の米 新米10kg」をご提供いただいています。
            お米のことなら山本様へ。配信もぜひご覧ください。
          </p>
          <SnsLinks
            x="https://x.com/KanameMitsumine"
            youtube="https://www.youtube.com/@米屋の山本/streams"
            name="山本様"
            onPaper
          />
        </div>
      </div>
    </div>
  </section>

  {/* ===== 投票のしかた ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead title="投票のしかた" en="HOW TO VOTE" />
      <ol class="steps">
        {steps.map((s) => (
          <li class="steps__item reveal">
            <span class="steps__n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.b}</p>
          </li>
        ))}
      </ol>

      {hasForm && (
        <p class="steps__cta reveal">
          <a class="btn btn-teal" href={EXHIBITION_VOTE.formUrl} target="_blank" rel="noopener noreferrer">
            応募フォームを開く
          </a>
        </p>
      )}
      <p class="note reveal" style="margin-top:1.5rem">
        ※投票はGoogleフォームで受け付けます。{EXHIBITION_VOTE.openTo}
      </p>
    </div>
  </section>

  {/* ===== 出演メンバー ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead
        title="出演メンバー"
        en="PLAYERS"
        lead="魂天4名による特別対局。この中から1位になる選手を予想してください。"
      />

      <div class="players">
        {EXHIBITION_PLAYERS.map((p) => <PersonCard person={p} showMeta />)}
      </div>
    </div>
  </section>

  {/* ===== エキシビジョン関連の賞 ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead
        title="エキシビジョンマッチの賞"
        en="EXHIBITION AWARDS"
        lead="この企画にまつわる3つの賞です。トーナメント本戦の賞品は賞品ページにまとめています。"
      />
      <div class="agrid">
        {EXHIBITION_PRIZES.map((p) => <PrizeCard prize={p} tone="crimson" />)}
      </div>

      <div class="cross reveal">
        <p>上位賞・主催賞・個人協賛賞など、その他すべての賞品はこちら。</p>
        <a class="btn" href={withBase('prizes/')}>賞品一覧を見る</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- 投票バー --- */
  .votebar {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.7rem, 4.5vw, 2.8rem);
  }
  .votebar__title {
    margin: 0.9rem 0 0.8rem;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.4rem, 4.4vw, 2.1rem);
    line-height: 1.4;
    color: #fff;
  }
  .votebar__title span { color: var(--c-gold-light); }
  .votebar__body { margin: 0 0 1.1rem; font-size: 0.95rem; line-height: 1.95; color: rgba(251, 243, 226, 0.88); }
  .votebar__body a { text-decoration: underline; text-underline-offset: 3px; }

  .votebar__open {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    padding: 0.7rem 1rem;
    font-size: 0.9rem;
    line-height: 1.7;
    background: rgba(14, 124, 110, 0.28);
    border: 1px solid rgba(42, 165, 149, 0.55);
    border-radius: 3px;
    color: #d5f6ef;
  }
  .votebar__open-tag {
    flex: none;
    padding: 0.12rem 0.7rem;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    border-radius: 999px;
    background: var(--c-teal);
    color: #fff;
  }

  .votebar__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.2rem; }
  .votebar__pending {
    padding: 0.75rem 1.6rem;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    color: rgba(251, 243, 226, 0.6);
    border: 1px dashed rgba(217, 164, 65, 0.5);
    border-radius: 999px;
  }
  .votebar__deadline { font-size: 0.86rem; color: var(--c-gold-light); }

  .votebar__side { display: grid; gap: 1rem; justify-items: center; }
  .votebar__prizefig { margin: 0; display: grid; gap: 0.5rem; justify-items: center; }
  .votebar__prize {
    width: min(100%, 380px);
    border-radius: 4px;
    border: 1px solid rgba(217, 164, 65, 0.5);
    box-shadow: var(--shadow-card);
  }
  .votebar__prizefig figcaption {
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: rgba(251, 243, 226, 0.62);
  }

  /* --- 山本様 紹介 --- */
  .yamamoto {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 2.6rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.4rem);
  }
  .yamamoto__figure { flex: none; }
  .yamamoto__figure img {
    width: clamp(150px, 23vw, 250px);
    height: auto;
    filter: drop-shadow(0 8px 20px rgba(60, 4, 18, 0.3));
  }
  .yamamoto__body { display: grid; align-content: center; gap: 0.7rem; justify-items: start; }
  .yamamoto__name {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.3rem, 4vw, 1.75rem);
    color: var(--c-crimson-deep);
    line-height: 1.3;
  }
  .yamamoto__lead {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.95;
    color: var(--c-ink);
    max-width: 40em;
  }

  @media (max-width: 640px) {
    .yamamoto { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .yamamoto__body { justify-items: center; }
  }

  /* --- ステップ --- */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .steps__item {
    position: relative;
    padding: 1.5rem 1.4rem 1.4rem;
    background: linear-gradient(160deg, #106d61, #093f38);
    border: 1px solid rgba(42, 165, 149, 0.7);
    border-radius: 4px;
  }
  .steps__n {
    font-family: var(--font-en);
    font-size: 2.2rem;
    line-height: 1;
    color: rgba(242, 216, 155, 0.42);
  }
  .steps__item h3 {
    margin: 0.5rem 0 0.5rem;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: 1.04rem;
    line-height: 1.5;
    color: #fff;
  }
  .steps__item p { margin: 0; font-size: 0.88rem; line-height: 1.85; color: rgba(251, 243, 226, 0.84); }
  .steps__cta { margin-top: 1.8rem; text-align: center; }

  /* --- 出演メンバー --- */
  .players {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(1rem, 2.4vw, 1.5rem);
  }

  .agrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(1rem, 2.4vw, 1.6rem);
  }

  .cross {
    margin-top: 2.4rem;
    padding: 1.6rem 1.8rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    background: linear-gradient(160deg, #a80c30, #6d0520);
    border: 1px solid rgba(217, 164, 65, 0.6);
    border-radius: 4px;
  }
  .cross p { margin: 0; font-family: var(--font-mincho); font-size: 1rem; color: var(--c-paper); }

  @media (max-width: 900px) { .votebar { grid-template-columns: 1fr; } }
</style>
