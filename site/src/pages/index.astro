---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE, EVENT, EXHIBITION_VOTE } from '../data/site';
import { HOSTS, SUPPORTERS, INVITED, EXHIBITION_PLAYERS } from '../data/guests';
import { SPONSORS } from '../data/sponsors';
import { withBase } from '../lib/path';


const highlights = [
  {
    num: '01',
    title: '雀魂 段位戦準拠の四麻トーナメント',
    body: '予選3回戦・準決勝・決勝の勝ち抜き方式。東風戦から半荘戦へ、勝ち上がるほど熱を増していく一日限りのトーナメントです。',
    href: '/rules/',
    cta: 'ルールを見る',
  },
  {
    num: '02',
    title: `招待枠${INVITED.length}名が集う秋の卓`,
    body: '麻雀プロ、Vtuber、配信者──それぞれの舞台で腕を磨いてきた面々が、明戸杯の卓を囲みます。解説は細谷拓真プロ。',
    href: '/guests/',
    cta: '出演者を見る',
  },
  {
    num: '03',
    title: '企業協賛による豪華賞品',
    body: `${SPONSORS.length}社の企業協賛に加え、主催賞・個人協賛賞も多数。上位賞から役満賞まで、卓上のドラマに賞品が用意されています。`,
    href: '/prizes/',
    cta: '賞品を見る',
  },
  {
    num: '04',
    title: '秋のエキシビジョンマッチ',
    body: '大会後半、魂天4名による特別対局。1位になる選手を予想して投票すると、抽選で「山本の米 新米10kg」が当たります。',
    href: '/exhibition/',
    cta: '投票する',
  },
];
---

<Base>
  <Hero />

  {/* ===== 概要 ===== */}
  <section class="section" id="about">
    <div class="shell">
      <SectionHead
        title="明戸杯2026とは"
        en="ABOUT"
        lead={`「${SITE.tagline}」をテーマに、主催・${SITE.organizer}がお届けする招待制の麻雀トーナメント。雀魂の卓上で繰り広げられる一日限りの祭典を、本会場（神視点）配信とともにお楽しみください。`}
      />

      <div class="about">
        <div class="about__info washi corner-key reveal">
          <dl>
            <div><dt>開催日</dt><dd>{EVENT.dateLabelJa}</dd></div>
            <div><dt>時 間</dt><dd>{EVENT.timeLabel}</dd></div>
            <div><dt>形 式</dt><dd>雀魂 段位戦準拠／四人打ちトーナメント</dd></div>
            <div>
              <dt>会 場</dt>
              <dd>
                {EVENT.streamUrl ? (
                  <a href={EVENT.streamUrl} target="_blank" rel="noopener noreferrer">
                    {EVENT.venue}<span class="about__ext" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  EVENT.venue
                )}
              </dd>
            </div>
            <div><dt>主 催</dt><dd>{SITE.organizer}</dd></div>
            <div><dt>主催サポート</dt><dd>{SUPPORTERS[0]!.name}</dd></div>
            <div><dt>タグ</dt><dd><a href={SITE.hashtagUrl} target="_blank" rel="noopener noreferrer">{SITE.hashtag}</a></dd></div>
          </dl>
        </div>

        <div class="about__cd reveal">
          <Countdown
            target={EVENT.startsAt}
            label="開幕まで"
            sublabel={`${EVENT.dateLabelJa} 13:00 開会式スタート`}
            finishedText="開幕！"
          />
          {EVENT.streamUrl && (
            <a class="btn btn-teal about__stream" href={EVENT.streamUrl} target="_blank" rel="noopener noreferrer">
              本会場（神視点）配信を見る
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {/* ===== 主催・主催サポート ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead
        title="主催・主催サポート"
        en="ORGANIZER"
        lead="明戸杯2026は、この2人がお届けします。"
      />

      <div class="hosts">
        {[...HOSTS, ...SUPPORTERS].map((p) => (
          <a class="hostcard reveal" href={withBase('guests/')}>
            <span class="hostcard__role">{p.role}</span>
            <img
              class="hostcard__img"
              src={withBase(`assets/guests/full/${p.image}`)}
              alt={p.name}
              width="620"
              height="700"
              loading="lazy"
              decoding="async"
            />
            <span class="hostcard__name">{p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 見どころ ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead title="大会の見どころ" en="HIGHLIGHTS" />

      <div class="hl">
        {highlights.map((h) => (
          <a class="hl__card reveal" href={withBase(h.href.slice(1))}>
            <span class="hl__num">{h.num}</span>
            <h3 class="hl__title">{h.title}</h3>
            <p class="hl__body">{h.body}</p>
            <span class="hl__cta">{h.cta}<span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ===== エキシビジョン告知 ===== */}
  <section class="section">
    <div class="shell">
      <div class="exbanner panel reveal">
        <div class="exbanner__body">
          <p class="ribbon">特別企画</p>
          <h2 class="exbanner__title">秋のエキシビジョンマッチ<span>ダービー</span></h2>
          <p class="exbanner__lead">
            大会後半に行われる魂天4名の特別対局。1位になる選手を予想して投票しよう。
            見事的中した方の中から抽選で1名様に <strong>「山本の米 新米10kg」</strong> をプレゼント。
          </p>

          <ul class="exbanner__players">
            {EXHIBITION_PLAYERS.map((p) => (
              <li><span class="exbanner__rank">{p.rank}</span>{p.name}</li>
            ))}
          </ul>

          <a class="btn" href={withBase('exhibition/')}>投票方法を見る</a>
        </div>

        <div class="exbanner__cd">
          <img
            class="exbanner__prize"
            src={withBase('assets/prizes/yamamoto-rice.webp')}
            alt="山本の米 新米10kg"
            width="760"
            height="1124"
            loading="lazy"
            decoding="async"
          />
          <p class="exbanner__note">受付：{EXHIBITION_VOTE.note}<br />{EXHIBITION_VOTE.openTo}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== 協賛ロゴ帯 ===== */}
  <section class="section">
    <div class="shell">
      <SectionHead
        title="企業協賛"
        en="SPONSORS"
        lead="明戸杯2026は、以下の企業様のご協賛により開催されます。"
      />
      <div class="logos reveal">
        {SPONSORS.map((s) => (
          <a class="logos__item" href={s.site ?? s.x} target="_blank" rel="noopener noreferrer" title={s.name}>
            <img src={withBase(`assets/sponsors/${s.logo}`)} alt={s.name} width="480" height="240" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
      <p style="text-align:center;margin-top:2rem">
        <a class="btn btn-ghost" href={withBase('sponsors/')}>協賛企業の詳細を見る</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* --- 概要 --- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.6rem);
    align-items: start;
  }
  .about__info { padding: clamp(1.6rem, 4vw, 2.4rem); }
  .about__info dl { margin: 0; display: grid; gap: 0.15rem; }
  .about__info dl > div {
    display: grid;
    grid-template-columns: 7.6em minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.72rem 0;
    border-bottom: 1px dashed rgba(90, 43, 36, 0.22);
  }
  .about__info dl > div:last-child { border-bottom: 0; }
  .about__info dt {
    font-family: var(--font-mincho);
    font-weight: 700;
    letter-spacing: 0.16em;
    white-space: nowrap;
    color: var(--c-crimson-deep);
    font-size: 0.92rem;
  }
  .about__info dd { margin: 0; font-size: 0.97rem; line-height: 1.7; }
  .about__info dd a { color: var(--c-teal-deep); text-decoration: underline; text-underline-offset: 3px; }
  .about__info dd a:hover { color: var(--c-crimson); }

  .about__info dd .about__ext { margin-left: 0.35rem; font-size: 0.85em; }

  .about__cd { display: grid; gap: 1rem; }
  .about__stream { width: 100%; }

  /* --- 主催・主催サポート --- */
  .hosts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
  }
  .hostcard {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: end;
    gap: 0.6rem;
    padding: 3rem 1.5rem 1.6rem;
    color: var(--c-paper);
    background:
      radial-gradient(90% 70% at 50% 15%, rgba(240, 84, 106, 0.34), transparent 68%),
      linear-gradient(165deg, rgba(163, 10, 46, 0.55), rgba(60, 3, 16, 0.85));
    border: 1px solid rgba(217, 164, 65, 0.45);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hostcard:hover {
    transform: translateY(-6px);
    border-color: var(--c-gold);
    box-shadow: 0 18px 42px rgba(30, 1, 10, 0.5);
    color: var(--c-paper);
  }
  .hostcard__role {
    position: absolute;
    top: 0;
    left: 0;
    padding: 0.32rem 1.3rem 0.32rem 0.85rem;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    color: var(--c-gold-pale);
    background: linear-gradient(100deg, var(--c-teal-deep), var(--c-teal));
    clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
  }
  .hostcard__img {
    width: auto;
    max-width: 100%;
    height: clamp(220px, 30vw, 330px);
    object-fit: contain;
    filter: drop-shadow(0 12px 26px rgba(30, 1, 10, 0.5));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .hostcard:hover .hostcard__img { transform: translateY(-6px) scale(1.03); }
  .hostcard__name {
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.2rem, 3.4vw, 1.6rem);
    letter-spacing: 0.08em;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  /* --- 見どころ --- */
  .hl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1rem, 2.4vw, 1.5rem);
  }
  .hl__card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.7rem 1.5rem 1.5rem;
    color: var(--c-paper);
    background: linear-gradient(165deg, rgba(163, 10, 46, 0.5), rgba(92, 5, 24, 0.7));
    border: 1px solid rgba(217, 164, 65, 0.38);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .hl__card:hover {
    transform: translateY(-6px);
    border-color: var(--c-gold);
    box-shadow: 0 18px 40px rgba(30, 1, 10, 0.5);
    color: var(--c-paper);
  }
  .hl__num {
    font-family: var(--font-en);
    font-size: 2.6rem;
    line-height: 1;
    color: rgba(242, 216, 155, 0.28);
    letter-spacing: 0.04em;
  }
  .hl__title {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: 1.13rem;
    line-height: 1.5;
    color: #fff;
  }
  .hl__body { margin: 0; font-size: 0.9rem; line-height: 1.85; color: rgba(251, 243, 226, 0.82); }
  .hl__cta {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--c-gold-light);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .hl__card:hover .hl__cta span { transform: translateX(4px); }
  .hl__cta span { transition: transform 0.25s ease; }

  /* --- エキシビジョンバナー --- */
  .exbanner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.8rem, 5vw, 3rem);
    overflow: hidden;
  }
  .exbanner__title {
    margin: 0.9rem 0 0.8rem;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.5rem, 4.6vw, 2.3rem);
    line-height: 1.3;
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
  }
  .exbanner__title span { color: var(--c-gold-light); }
  .exbanner__lead { margin: 0 0 1.2rem; font-size: 0.95rem; line-height: 1.9; color: rgba(251, 243, 226, 0.88); }
  .exbanner__lead strong { color: var(--c-gold-light); }
  .exbanner__players {
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .exbanner__players li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.28rem 0.95rem;
    border: 1px solid rgba(217, 164, 65, 0.5);
    border-radius: 999px;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.92rem;
    background: rgba(45, 2, 12, 0.35);
  }
  .exbanner__cd { display: grid; gap: 0.9rem; justify-items: center; }
  .exbanner__prize {
    width: min(100%, 230px);
    border-radius: 4px;
    border: 1px solid rgba(217, 164, 65, 0.5);
    box-shadow: var(--shadow-card);
  }
  .exbanner__note {
    margin: 0;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.8;
    color: rgba(251, 243, 226, 0.75);
  }

  .exbanner__rank {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: #a7ecdf;
    padding: 0.02rem 0.45rem;
    border-radius: 2px;
    background: rgba(14, 124, 110, 0.45);
  }

  /* --- 協賛ロゴ --- */
  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .logos__item {
    display: grid;
    place-items: center;
    padding: 0.9rem;
    background: rgba(251, 243, 226, 0.94);
    border: 1px solid rgba(217, 164, 65, 0.6);
    border-radius: 3px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .logos__item:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(30, 1, 10, 0.45); }
  .logos__item img { width: 100%; height: auto; }

  @media (max-width: 900px) {
    .about, .exbanner { grid-template-columns: 1fr; }
  }
</style>
