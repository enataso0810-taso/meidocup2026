---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import SnsLinks from '../components/SnsLinks.astro';
import { CREATORS, MODERATORS } from '../data/creators';
import type { Creator } from '../data/creators';
import { withBase } from '../lib/path';

const list: Array<[Creator[], string, string, string]> = [
  [CREATORS, 'クリエイター', 'CREATORS', '明戸杯2026のビジュアル・楽曲・サイトを手がけたクリエイターの皆さまです。'],
  [
    MODERATORS,
    '大会サポートスタッフ',
    'SUPPORT STAFF',
    '当日の配信・コメント欄をモデレーターとして支えてくださる皆さまです。',
  ],
];
---

<Base
  title="クリエイター紹介"
  pageTitle="クリエイター紹介"
  pageTitleEn="CREATORS"
  pageLead="大会を形づくってくださった皆さまをご紹介します。"
>
  {
    list.map(([people, title, en, lead]) => (
      <section class="section">
        <div class="shell">
          <SectionHead title={title} en={en} lead={lead} />

          <div class="clist">
            {people.map((c) => (
              <article class="ccard washi corner-key reveal">
                <div class="ccard__figure">
                  <img
                    class="ccard__img"
                    src={withBase(`assets/creators/${c.image}`)}
                    alt={c.name}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <div class="ccard__body">
                  <p class="ccard__role">{c.role}</p>
                  <h3 class="ccard__name">{c.name}</h3>
                  <p class="ccard__bio">{c.bio}</p>
                  <SnsLinks x={c.x} site={c.link} siteLabel={c.linkLabel} name={c.name} onPaper />
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .clist { display: grid; gap: clamp(1rem, 2.6vw, 1.6rem); }

  .ccard {
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 2.4rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.2rem);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .ccard:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(30, 1, 10, 0.42); }

  .ccard__figure { position: relative; flex: none; }
  .ccard__figure::before {
    content: '';
    position: absolute;
    inset: -7px;
    border: 1px solid rgba(217, 164, 65, 0.55);
    border-radius: 50%;
  }
  .ccard__img {
    width: clamp(110px, 17vw, 168px);
    aspect-ratio: 1;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--c-gold);
    box-shadow: 0 6px 20px rgba(60, 4, 18, 0.32);
  }

  .ccard__body { display: grid; align-content: center; gap: 0.6rem; }
  .ccard__role {
    margin: 0;
    justify-self: start;
    padding: 0.16rem 0.9rem;
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    border-radius: 2px;
    background: rgba(14, 124, 110, 0.14);
    border: 1px solid rgba(14, 124, 110, 0.35);
    color: var(--c-teal-deep);
  }
  .ccard__name {
    margin: 0;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.35rem, 4vw, 1.85rem);
    color: var(--c-crimson-deep);
    line-height: 1.3;
  }
  .ccard__bio {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.95;
    color: var(--c-ink);
    max-width: 42em;
  }

  @media (max-width: 680px) {
    .ccard { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 1.2rem; }
    .ccard__body { justify-items: center; }
    .ccard__role { justify-self: center; }
  }
</style>
