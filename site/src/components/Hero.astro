---
import { SITE, EVENT } from '../data/site';
import { withBase } from '../lib/path';
---

<section class="hero">
  <canvas class="hero__canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__rays" aria-hidden="true"></div>

  <div class="hero__content shell">
    <p class="hero__eyebrow">
      <span class="hero__eyebrow-line" aria-hidden="true"></span>
      {EVENT.dateLabelJa}
      <span class="hero__eyebrow-line" aria-hidden="true"></span>
    </p>

    <h1 class="hero__logo">
      <img
        src={withBase('assets/logo/logo-main.png')}
        alt={SITE.title}
        width="1000"
        height="717"
        fetchpriority="high"
      />
      <span class="sr-only">{SITE.title}</span>
    </h1>

    <p class="hero__tagline" data-split={SITE.tagline}>
      {SITE.tagline.split('').map((c, i) => (
        <span style={`--i:${i}`}>{c}</span>
      ))}
    </p>

    <p class="hero__sub">
      招待制 四人打ち麻雀トーナメント　／　主催：{SITE.organizer}
    </p>

    <div class="hero__cta">
      <a class="btn" href={withBase('schedule/')}>大会の流れを見る</a>
      <a class="btn btn-ghost" href={withBase('exhibition/')}>エキシビジョンに投票</a>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label="下へスクロール">
    <span class="hero__scroll-txt">SCROLL</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<script>
  import { initHero } from '../scripts/hero';
  const canvas = document.getElementById('hero-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    // ヒーローが画面内にある間だけ描画
    let dispose: (() => void) | null = null;
    const start = () => { if (!dispose) dispose = initHero(canvas); };
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(start, { timeout: 800 });
    } else {
      setTimeout(start, 120);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(130% 100% at 50% 8%, #a30a2e 0%, #7d0722 42%, #4d0316 100%);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
  }
  .hero.no-webgl .hero__canvas { display: none; }

  /* 中央を暗く落として文字を読みやすく */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(58% 52% at 50% 46%, rgba(77, 3, 22, 0.86) 0%, rgba(77, 3, 22, 0.42) 55%, transparent 78%),
      linear-gradient(180deg, rgba(45, 2, 12, 0.72) 0%, transparent 26%, transparent 62%, rgba(45, 2, 12, 0.9) 100%);
    pointer-events: none;
  }
  /* 金色の光条 */
  .hero__rays {
    position: absolute;
    inset: -20%;
    z-index: 1;
    background: conic-gradient(
      from 0deg at 50% 42%,
      transparent 0deg,
      rgba(242, 216, 155, 0.09) 8deg,
      transparent 16deg,
      transparent 44deg,
      rgba(242, 216, 155, 0.07) 52deg,
      transparent 60deg
    );
    mix-blend-mode: screen;
    animation: rays 64s linear infinite;
    pointer-events: none;
  }
  @keyframes rays { to { transform: rotate(360deg); } }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 7rem 0 6rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 1.6rem;
    font-family: var(--font-en);
    font-size: clamp(0.78rem, 1.9vw, 1rem);
    letter-spacing: 0.3em;
    color: var(--c-gold-light);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    animation: fadeDown 1s 0.15s both;
  }
  .hero__eyebrow-line {
    width: clamp(28px, 8vw, 74px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--c-gold));
  }
  .hero__eyebrow-line:last-child { background: linear-gradient(90deg, var(--c-gold), transparent); }

  .hero__logo { margin: 0; animation: logoIn 1.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero__logo img {
    width: clamp(280px, 52vw, 620px);
    margin-inline: auto;
    filter:
      drop-shadow(0 0 34px rgba(255, 190, 160, 0.4))
      drop-shadow(0 12px 30px rgba(0, 0, 0, 0.55));
  }

  .hero__tagline {
    margin: 1.6rem 0 0.9rem;
    font-family: var(--font-mincho);
    font-weight: 800;
    font-size: clamp(1.25rem, 4.4vw, 2.35rem);
    letter-spacing: 0.16em;
    color: #fff;
    text-shadow: 0 2px 20px rgba(200, 16, 60, 0.85), 0 2px 8px rgba(0, 0, 0, 0.6);
  }
  .hero__tagline span {
    display: inline-block;
    animation: charIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.75s + var(--i) * 0.045s);
  }

  .hero__sub {
    margin: 0 0 2.4rem;
    font-size: clamp(0.82rem, 2.2vw, 0.98rem);
    letter-spacing: 0.14em;
    color: rgba(251, 243, 226, 0.82);
    animation: fadeUp 1s 1.3s both;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    animation: fadeUp 1s 1.5s both;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    z-index: 2;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    animation: fadeUp 1s 1.9s both;
  }
  .hero__scroll-txt {
    font-family: var(--font-en);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    color: var(--c-gold-light);
  }
  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(180deg, var(--c-gold), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 16px;
    background: #fff;
    animation: scrollDot 2.2s ease-in-out infinite;
  }

  @keyframes logoIn {
    from { opacity: 0; transform: translateY(34px) scale(0.94); filter: blur(8px); }
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  @keyframes charIn { from { opacity: 0; transform: translateY(18px) rotateX(-60deg); } to { opacity: 1; transform: none; } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes fadeDown { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
  @keyframes scrollDot { 0% { transform: translateY(-16px); } 60%, 100% { transform: translateY(46px); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__rays { animation: none; }
    .hero__scroll-line::after { animation: none; }
  }
  @media (max-width: 620px) {
    .hero__cta .btn { width: 100%; max-width: 320px; }
  }
</style>
