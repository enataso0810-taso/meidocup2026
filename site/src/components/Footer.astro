---
import { NAV, SITE, EVENT } from '../data/site';
import { withBase } from '../lib/path';
---

<footer class="ftr">
  <div class="ftr__key" aria-hidden="true"></div>
  <div class="shell ftr__inner">
    <div class="ftr__brand">
      <img src={withBase("assets/logo/logo-main.webp")} alt={SITE.title} width="1000" height="726" />
      <p class="ftr__tagline">{SITE.tagline}</p>
      <p class="ftr__date">{EVENT.dateLabelJa}　{EVENT.timeLabel}</p>
    </div>

    <nav class="ftr__nav" aria-label="フッターナビゲーション">
      <ul>
        {NAV.map((n) => <li><a href={withBase(n.href.slice(1))}>{n.label}</a></li>)}
      </ul>
      <a class="ftr__tag" href={SITE.hashtagUrl} target="_blank" rel="noopener noreferrer">
        {SITE.hashtag} をXで見る
      </a>
    </nav>
  </div>

  <p class="ftr__copy">
    © 2026 {SITE.title}（主催：{SITE.organizer}）
  </p>
</footer>

<style>
  .ftr {
    position: relative;
    margin-top: clamp(4rem, 10vw, 7rem);
    padding: 0 0 2rem;
    background: linear-gradient(180deg, rgba(60, 3, 16, 0.55), rgba(45, 2, 12, 0.9));
    border-top: 1px solid rgba(217, 164, 65, 0.35);
  }
  .ftr__key {
    height: 10px;
    background: repeating-linear-gradient(90deg, var(--c-gold) 0 16px, transparent 16px 32px);
    opacity: 0.35;
  }
  .ftr__inner {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4rem);
    padding: clamp(2.5rem, 6vw, 4rem) 0 2rem;
    align-items: start;
  }
  .ftr__brand img { width: clamp(180px, 22vw, 240px); filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4)); }
  .ftr__tagline {
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.14em;
    color: var(--c-gold-light);
    margin: 1rem 0 0.35rem;
  }
  .ftr__date { margin: 0; font-size: 0.85rem; color: rgba(251, 243, 226, 0.7); }

  .ftr__nav ul {
    list-style: none;
    margin: 0 0 1.6rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.6rem 1rem;
  }
  .ftr__nav a { color: rgba(251, 243, 226, 0.86); font-size: 0.92rem; }
  .ftr__nav a::before { content: '◇ '; color: var(--c-gold); font-size: 0.7em; }
  .ftr__nav a:hover { color: #fff; }
  .ftr__tag {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    border: 1px solid rgba(217, 164, 65, 0.55);
    border-radius: 999px;
    font-size: 0.86rem;
    color: var(--c-gold-light);
  }
  .ftr__tag:hover { background: rgba(217, 164, 65, 0.14); color: #fff; }

  .ftr__copy {
    text-align: center;
    margin: 0;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(217, 164, 65, 0.18);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgba(251, 243, 226, 0.55);
  }

  @media (max-width: 760px) {
    .ftr__inner { grid-template-columns: 1fr; }
    .ftr__brand { text-align: center; }
    .ftr__brand img { margin-inline: auto; }
  }
</style>
