---
import { NAV, SITE } from '../data/site';
import { withBase } from '../lib/path';
// base を取り除いた「サイト内パス」を求める（末尾スラッシュを正規化）
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = `${Astro.url.pathname.slice(baseUrl.length) || '/'}`.replace(/\/*$/, '/');
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="hdr" id="site-header">
  <div class="hdr__inner">
    <a class="hdr__logo" href={withBase('')} aria-label={`${SITE.title} ホーム`}>
      <img src={withBase('assets/logo/logo-horizontal.webp')} alt={SITE.title} width="1200" height="412" />
    </a>

    <nav class="hdr__nav" aria-label="メインナビゲーション">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={withBase(n.href.slice(1))} class:list={[{ 'is-current': isActive(n.href) }]}>
                <span class="ja">{n.label}</span>
                <span class="en">{n.en}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="drawer" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="drawer" id="drawer" hidden>
  <nav aria-label="モバイルナビゲーション">
    <ul>
      {
        NAV.map((n) => (
          <li>
            <a href={withBase(n.href.slice(1))} class:list={[{ 'is-current': isActive(n.href) }]}>
              <span class="en">{n.en}</span>
              <span class="ja">{n.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__burger');
  const drawer = document.querySelector<HTMLElement>('#drawer');
  const hdr = document.querySelector<HTMLElement>('#site-header');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
    if (drawer) drawer.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
    document.documentElement.classList.toggle('drawer-open', !open);
  });

  drawer?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) btn?.click();
  });

  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    transition: background 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
  }
  .hdr.is-scrolled {
    background: linear-gradient(180deg, rgba(92, 5, 24, 0.94), rgba(92, 5, 24, 0.8));
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(217, 164, 65, 0.35), 0 8px 26px rgba(0, 0, 0, 0.3);
  }
  .hdr__inner {
    width: min(100% - 2rem, 1320px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0.7rem 0;
  }
  .hdr__logo {
    flex: none;
    width: clamp(130px, 15vw, 190px);
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.45));
    transition: transform 0.25s ease;
  }
  .hdr__logo:hover { transform: scale(1.04); }

  .hdr__nav { margin-left: auto; }
  .hdr__nav ul {
    display: flex;
    gap: clamp(0.5rem, 1.4vw, 1.35rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr__nav a {
    display: grid;
    justify-items: center;
    gap: 0.1rem;
    padding: 0.35rem 0.25rem;
    color: var(--c-paper);
    position: relative;
  }
  .hdr__nav .ja {
    font-family: var(--font-mincho);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
  }
  .hdr__nav .en {
    font-family: var(--font-en);
    font-size: 0.52rem;
    letter-spacing: 0.2em;
    color: rgba(242, 216, 155, 0.72);
  }
  .hdr__nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--c-gold);
    transform: translateX(-50%);
    transition: width 0.25s ease;
  }
  .hdr__nav a:hover::after { width: 100%; }
  .hdr__nav a.is-current { color: var(--c-gold-light); }
  .hdr__nav a.is-current::after { width: 100%; }

  .hdr__burger {
    display: none;
    margin-left: auto;
    width: 46px;
    height: 40px;
    border: 1px solid rgba(217, 164, 65, 0.6);
    border-radius: 3px;
    background: rgba(92, 5, 24, 0.6);
    cursor: pointer;
    position: relative;
  }
  .hdr__burger span {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 2px;
    background: var(--c-gold-light);
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  .hdr__burger span:nth-child(1) { top: 13px; }
  .hdr__burger span:nth-child(2) { top: 19px; }
  .hdr__burger span:nth-child(3) { top: 25px; }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .drawer {
    position: fixed;
    inset: 0;
    z-index: 99;
    padding: 6rem 1.5rem 2rem;
    overflow-y: auto;
    background: linear-gradient(170deg, rgba(92, 5, 24, 0.98), rgba(60, 3, 16, 0.99));
    backdrop-filter: blur(6px);
  }
  .drawer ul { list-style: none; margin: 0; padding: 0; }
  .drawer li + li { border-top: 1px solid rgba(217, 164, 65, 0.22); }
  .drawer a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 0.4rem;
    color: var(--c-paper);
  }
  .drawer .en {
    font-family: var(--font-en);
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    color: var(--c-gold);
    min-width: 8.5em;
  }
  .drawer .ja { font-family: var(--font-mincho); font-weight: 700; font-size: 1.15rem; }
  .drawer a.is-current .ja { color: var(--c-gold-light); }

  @media (max-width: 1080px) {
    .hdr__nav { display: none; }
    .hdr__burger { display: block; }
  }
</style>
