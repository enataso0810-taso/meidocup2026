---
interface Props {
  x?: string;
  youtube?: string;
  site?: string;
  siteLabel?: string;
  onPaper?: boolean;
  name?: string;
}
const { x, youtube, site, siteLabel, onPaper = false, name = '' } = Astro.props;
---

<div class:list={['sns', { 'sns-on-paper': onPaper }]}>
  {x && (
    <a href={x} target="_blank" rel="noopener noreferrer" title={`${name} X`} aria-label={`${name} のX（旧Twitter）`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
  )}
  {youtube && (
    <a href={youtube} target="_blank" rel="noopener noreferrer" title={`${name} YouTube`} aria-label={`${name} のYouTubeチャンネル`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6z"/></svg>
    </a>
  )}
  {site && (
    <a href={site} target="_blank" rel="noopener noreferrer" title={siteLabel ?? 'Webサイト'} aria-label={`${name} ${siteLabel ?? 'Webサイト'}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.9 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a8.1 8.1 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4Zm.84 2h2.95c.33 1.25.8 2.45 1.38 3.56A8.03 8.03 0 0 1 5.1 16Zm2.95-8H5.1a8.03 8.03 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.05 8ZM12 19.96A13.6 13.6 0 0 1 10.09 16h3.82A13.6 13.6 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.23 5.56c.58-1.11 1.05-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.1 8.1 0 0 1 0 4Z"/></svg>
    </a>
  )}
</div>
